# Supabase bağlantı bilgileri
# Bu dosyayı .env olarak kopyalayıp gerçek değerlerle doldurun:
#   cp .env.example .env
# Değerleri Supabase panelinden alın: Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ⚠️ SADECE SUNUCU TARAFI — yeni firma/kullanıcı oluşturmak için (Supabase admin API).
# ASLA NEXT_PUBLIC_ öneki ALMAZ, asla client'a sızmaz. Project Settings > API > service_role.
# .env'e ve Vercel ortam değişkenlerine ELLE eklenir.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
