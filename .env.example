# =============================================================
# Supabase — zorunlu
# Değerleri Supabase panelinden alın: Project Settings > API
#   cp .env.example .env
# =============================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ⚠️ SADECE SUNUCU TARAFI — yeni firma/kullanıcı oluşturmak ve cron için.
# ASLA NEXT_PUBLIC_ öneki ALMAZ, asla client'a sızmaz.
# Project Settings > API > service_role.
# .env'e ve Vercel ortam değişkenlerine ELLE eklenir.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# =============================================================
# AI Metin Yazıcı — opsiyonel
# Tanımlı değilse /metin-yazici şablon yanıt üretir (demo modu).
# Anahtar eklenince gerçek Claude üretimine geçer.
# =============================================================
ANTHROPIC_API_KEY=

# =============================================================
# Zamanlanmış görevler — opsiyonel ama önerilir
# Tanımlıysa /api/cron/reminders yalnızca bu anahtarla çağrılabilir.
# Vercel Cron bu başlığı otomatik gönderir.
# =============================================================
CRON_SECRET=

# =============================================================
# Mesajlaşma sağlayıcıları — opsiyonel
#
# NOT: Bu anahtarlar tek tek firmalar için Ayarlar > Entegrasyonlar
# ekranından (integrations tablosuna) girilir. Buradakiler yalnızca
# yerel geliştirme/test içindir.
# =============================================================

# Netgsm (SMS)
SMS_USERCODE=
SMS_PASSWORD=
SMS_MSGHEADER=

# Resend (e-posta)
RESEND_API_KEY=
RESEND_FROM=

# WhatsApp Cloud API (Meta)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
